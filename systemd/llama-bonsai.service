[Unit]
Description=llama-server: Ternary-Bonsai-2-27B PTQ1_0 (PrismML fork, port 8080)
Documentation=https://www.modelscope.cn/models/prism-ml/Ternary-Bonsai-2-27B-gguf
After=network.target

[Service]
Type=simple
Environment=HOME=/home/zyl
Environment=LD_LIBRARY_PATH=/home/zyl/bonsai2/bin
WorkingDirectory=/home/zyl/bonsai2/bin
ExecStart=/home/zyl/bonsai2/bin/llama-server \
  -m /home/zyl/models/Ternary-Bonsai-2-27B-PTQ1_0.gguf \
  -c 262144 -ctk q4_0 -ctv q4_0 \
  -ngl 99 -fa on -np 1 --jinja -t 16 --reasoning-preserve --cache-reuse 256 \
  --temp 1.0 --top-p 0.95 --top-k 20 \
  --host 0.0.0.0 --port 8080 \
  --api-key sk-lan-97f1c41bb1642ab23f810c65 \
  -a bonsai-27b
Restart=on-failure
RestartSec=10
StandardOutput=append:/home/zyl/bonsai2/logs/server.log
StandardError=append:/home/zyl/bonsai2/logs/server.log

[Install]
WantedBy=default.target
