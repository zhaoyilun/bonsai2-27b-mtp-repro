[Unit]
Description=llama-server: Ternary-Bonsai-2-27B PQ2_0 + MTP speculative (port 8080)
Documentation=https://www.modelscope.cn/models/prism-ml/Ternary-Bonsai-2-27B-gguf
After=network.target

[Service]
Type=simple
Environment=HOME=/home/zyl
Environment=LD_LIBRARY_PATH=/home/zyl/bonsai2/mtp-runtime/source/llama/build/bin
WorkingDirectory=/home/zyl/bonsai2/mtp-runtime/source/llama/build/bin
ExecStart=/home/zyl/bonsai2/mtp-runtime/source/llama/build/bin/llama-server \
  -m /home/zyl/models/Ternary-Bonsai-2-27B-PQ2_0-MTP-Q8_0.gguf \
  -c 262144 -ctk q4_0 -ctv q4_0 \
  -ngl 99 -fa on -np 1 --jinja -t 16 --reasoning-preserve \
  --spec-type draft-mtp --spec-draft-n-max 2 \
  --temp 1.0 --top-p 0.95 --top-k 20 \
  --host 0.0.0.0 --port 8080 \
  --api-key sk-lan-CHANGE-ME \
  -a bonsai-27b
Restart=on-failure
RestartSec=10
StandardOutput=append:/home/zyl/bonsai2/logs/mtp-server.log
StandardError=append:/home/zyl/bonsai2/logs/mtp-server.log

[Install]
WantedBy=default.target
